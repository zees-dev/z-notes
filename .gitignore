# sqlite index is a rebuildable cache — never committed (SPEC §5/§7)
*.db
*.db-wal
*.db-shm
.znotes/index.db*

# the trash is RUNTIME STATE holding the payload of deleted notes, per
# deployment — committing it would put deleted documents (including whatever
# they contained) into this repo's history, which is the one place a delete
# cannot reach
.znotes/trash/

node_modules/
dist/
.DS_Store

# agent scratch — measurement harnesses and one-off probes. This repo's first
# commit is still pending, so an unignored scratch directory rides along into
# the initial commit and stays in the history after it is deleted.
.scratch/
